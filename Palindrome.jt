public class Calcer {
    public tenPowFloorLog10(n) {
        if (n < 10) return 1;
        return 10 * this.tenPowFloorLog10(n / 10);
    }

    public reverse(n) {
        if (n < 10) return n;
        return (n%10) * this.tenPowFloorLog10(n) + this.reverse(n / 10);
    }

    public isPalindrome(n) {
        if (n < 10) return true;
        pval = this.tenPowFloorLog10(n);
        return (n % 10) == (n / pval) && this.isPalindrome((n % pval) / 10);
    }
}
